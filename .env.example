# Copy to .env and fill in. NEVER commit .env.
# Live provider: groq (default for this build) | anthropic | mock (automated tests only, never for the demo)
AI_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key-here
# Only needed if AI_PROVIDER=anthropic (then set LLM_MODEL=claude-opus-5-5)
ANTHROPIC_API_KEY=
PORT=3000
# Local-demo admin PIN (paper requires 2026)
ADMIN_PIN=2026
# Show the admin PIN on the About screen for the demo (set to false to hide it)
SHOW_ADMIN_PIN=true
